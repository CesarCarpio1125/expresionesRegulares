{
    "name": "laravel/laravel",
    "type": "project",
    "description": "RegexLab - Interactive Regex Learning Platform",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/inertia": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}